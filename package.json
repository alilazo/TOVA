{
  "name": "tova",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tova/web --filter @tova/api dev",
    "dev:web": "pnpm --filter @tova/web dev",
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --reload --port 8000",
    "build": "pnpm --filter @tova/web build",
    "lint": "pnpm --filter @tova/web lint",
    "typecheck": "pnpm --filter @tova/web typecheck",
    "test": "pnpm --filter @tova/web test",
    "test:e2e": "pnpm --filter @tova/web test:e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
